%% Parent-to-child arrows represent one-to-many logical relationships.
%% Counts follow TPC-H scale-factor rules; lineitem is approximate.
%% SF200 is nominal data scale, not compressed database size.
flowchart TB
    region["region<br/>5 rows"]
    nation["nation<br/>25 rows"]
    customer["customer<br/>30M rows"]
    supplier["supplier<br/>2M rows"]
    part["part<br/>40M rows"]
    orders["orders<br/>300M rows"]
    partsupp["partsupp<br/>160M rows"]
    lineitem["lineitem<br/>≈1.2B rows"]

    region --> nation
    nation --> customer
    nation --> supplier
    customer --> orders
    supplier --> partsupp
    part --> partsupp
    orders --> lineitem
    partsupp --> lineitem
